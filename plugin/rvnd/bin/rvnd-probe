#!/usr/bin/env python3
"""rvnd-probe — report whether real RVND is installed and in the compatible range.

The other floor tools call this internally to decide advisory-vs-routed; run it
yourself to see, in one line, which mode the plugin is in on this machine.

Usage:
  rvnd-probe            # human + JSON
  rvnd-probe --json     # JSON only (stdout)

Exit code is always 0: presence is information, not failure.
"""
from __future__ import annotations

import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "scripts"))
from rvnd_floor_lib import probe_engine  # noqa: E402


def main(argv: list[str]) -> int:
    engine = probe_engine()
    if "--json" in argv:
        print(json.dumps(engine, indent=2, sort_keys=True))
        return 0
    state = "ENGINE" if (engine["present"] and engine["compatible"]) else "FLOOR"
    print(f"[{state}] {engine['reason']}", file=sys.stderr)
    print(json.dumps(engine, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
