{
  "$schema": "../schemas/loomground-package.schema.json",
  "schemaVersion": 1,
  "name": "rvnd",
  "version": "0.6.0",
  "license": "AGPL-3.0-only",
  "description": "The RVND governance skill layer: eight user-action skills that drive the typed MCP governance cycle, onboard policy into the shared 5D+nD graph, obtain server decisions, resolve rule conflicts, report the whole governance board, and verify signed receipts.",
  "author": {
    "name": "flxk1"
  },
  "keywords": [
    "governance",
    "policy",
    "rvnd",
    "loomground",
    "mcp",
    "oversight",
    "audit",
    "fail-closed",
    "commercial"
  ],
  "skills": [
    {
      "name": "govern-an-action",
      "path": "skills/govern-an-action",
      "provides": [
        "rvnd.govern-an-action"
      ]
    },
    {
      "name": "onboard-a-policy",
      "path": "skills/onboard-a-policy",
      "provides": [
        "governance.onboard-policy"
      ]
    },
    {
      "name": "sign-off",
      "path": "skills/sign-off",
      "provides": [
        "rvnd.sign-off"
      ]
    },
    {
      "name": "resolve-a-conflict",
      "path": "skills/resolve-a-conflict",
      "provides": [
        "governance.resolve-conflict"
      ]
    },
    {
      "name": "audit-the-ai",
      "path": "skills/audit-the-ai",
      "provides": [
        "rvnd.audit-the-ai"
      ]
    },
    {
      "name": "verify-a-receipt",
      "path": "skills/verify-a-receipt",
      "provides": [
        "rvnd.verify-receipt"
      ]
    },
    {
      "name": "revoke-or-erase",
      "path": "skills/revoke-or-erase",
      "provides": [
        "rvnd.revoke-or-erase"
      ]
    },
    {
      "name": "build-a-surface",
      "path": "skills/build-a-surface",
      "provides": [
        "rvnd.build-surface"
      ]
    }
  ],
  "capabilities": {
    "rvnd.govern-an-action": {
      "mode": "read-write",
      "humanConfirmation": true
    },
    "governance.onboard-policy": {
      "mode": "read-write",
      "humanConfirmation": false
    },
    "rvnd.sign-off": {
      "mode": "read-write",
      "humanConfirmation": true
    },
    "governance.resolve-conflict": {
      "mode": "read-write",
      "humanConfirmation": true
    },
    "rvnd.audit-the-ai": {
      "mode": "read",
      "humanConfirmation": false
    },
    "rvnd.verify-receipt": {
      "mode": "read-write",
      "humanConfirmation": true
    },
    "rvnd.revoke-or-erase": {
      "mode": "read-write",
      "humanConfirmation": true
    },
    "rvnd.build-surface": {
      "mode": "read",
      "humanConfirmation": false
    }
  },
  "runtime": {
    "python": ">=3.10",
    "network": false,
    "config": [],
    "requires": [
      "rvnd>=0.6.8.4,<0.7"
    ]
  },
  "adapters": {
    "claude": {},
    "codex": {
      "interface": {
        "displayName": "RVND Governance",
        "shortDescription": "Drive the RVND governance MCP server safely",
        "longDescription": "Eight user-action skills drive RVND's typed governance cycle: govern an action, onboard a policy into the shared 5D+nD graph, sign off, resolve a conflict, audit the AI, verify a receipt, revoke or erase, and build a surface. They cascade local-first — the engine decides when present, the cloud LLM is the labelled fallback — so a request is never shown as a grant.",
        "developerName": "Flxk1",
        "category": "Productivity",
        "capabilities": [
          "Governance cycle",
          "Policy onboarding into the shared graph",
          "Governed rule decisions",
          "Human oversight",
          "Whole-board audit + signed-receipt verification",
          "Incident response",
          "Local-first, fail-closed"
        ],
        "defaultPrompt": [
          "Run this action through RVND's governance cycle.",
          "Onboard this policy into the governance graph.",
          "Resolve this governance conflict without inventing a winner.",
          "Put this to a person for approve/hold/deny.",
          "Audit what this AI may do, and verify a receipt against the signed chain."
        ]
      }
    },
    "generic": {}
  }
}
