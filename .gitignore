# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Node / app
node_modules/
# also match a symlink named node_modules (the dir pattern above misses it)
node_modules

# local model weights (multi-GB, never shipped)
models/

# editor / OS
.DS_Store

# Local workspace records
_docs/
STATE.md
ROADMAP.md

# macOS / iCloud duplicate artifacts (e.g. "foo 2.py", "foo copy.py")
* [0-9].*
* [0-9][0-9].*
* copy.*
* copy [0-9].*

# stray downloaded source docs (not shipped)
docs/OJ*.pdf

# generated licence inventory (rebuild with a CycloneDX scan; not shipped)
sbom.cdx.json

# demo workspace runtime state — regenerated by demos/seed_child_protection.py;
# the script is the template, not the folder's contents (audit chain, .versum
# knowledge graph, uploaded copies)
demos/child-protection-workspace/

# RV-19 coverage artifacts
.coverage
coverage.xml
htmlcov/

# The ctrl audit logger resolved its path relative to CWD and sprayed
# `_ctrl/audit-log.md` into whatever directory a session stood in — including
# server/src, i.e. inside the shipped package. The logger is fixed, but these
# stay ignored so a recurrence cannot ride into a commit.
work/_ctrl/
