# Copy to .env and fill. See quickstart-company.md.
OAUTH2_PROXY_PROVIDER=google
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# openssl rand -base64 32 | head -c 32
OAUTH2_PROXY_COOKIE_SECRET=
RVND_PROXY_SHARED_SECRET=
OAUTH2_PROXY_EMAIL_DOMAINS=corp.example
# public URL the action links point back to (the proxy's address)
RVND_PUBLIC_URL=http://localhost:4180
